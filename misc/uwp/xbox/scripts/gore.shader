// Blood pools, wall runs and footprints for the gore effects (code/cgame/cg_gore.c).
// Textures are generated by tools/gen_gore_textures.py: alpha is the blood,
// the colour (red/green, darkened by the level's light) comes from vertex
// colours set in cg_gore.c.

gore/bloodpool1
{
	polygonOffset
	nopicmip
	sort decal
	{
		clampmap gore/bloodpool1.tga
		blendFunc GL_SRC_ALPHA GL_ONE_MINUS_SRC_ALPHA
		rgbGen vertex
		alphaGen vertex
	}
}

