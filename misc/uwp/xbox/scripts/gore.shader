// Blood pools and wall runs for the gore effects (code/cgame/cg_gore.c).
// Textures are generated by tools/gen_gore_textures.py. They hold how much
// light the blood absorbs, and the multiply-style blend darkens the surface
// underneath, so the blood is lit by the level like the game's own decals.
// Green blood uses the *_green textures.

gore/bloodpool1
{
	polygonOffset
	nopicmip
	sort decal
	{
		clampmap gore/bloodpool1.tga
		blendFunc GL_ZERO GL_ONE_MINUS_SRC_COLOR
		rgbGen vertex
	}
}

