// Named zz_* on purpose: the game joins all shader files into one text block
// (in reverse name order), and a broken RealRTCW shader file
// (models_mapobjects_et.shader, missing a closing brace) swallows every file
// that comes after it - so this file has to sort after it to be read first.

// Blood pools, wall runs and footprints for the gore effects (code/cgame/cg_gore.c).
// Textures are generated by tools/gen_gore_textures.py. They're drawn as a
// filter over the surface (dst * (1 - tex)), so blood is lit by the level
// exactly like the surface under it. Vertex colours fade them (grey = how
// strong). The #green shaders are spelled out so the renderer doesn't make
// its automatic red/green-swapped variant (wrong for absorption textures).

gore/bloodpool1
{
	polygonOffset
	nopicmip
	cull none
	{
		clampmap gore/bloodpool1.tga
		blendFunc GL_ZERO GL_ONE_MINUS_SRC_COLOR
		rgbGen vertex
	}
}

gore/bloodpool1#green
{
	polygonOffset
	nopicmip
	cull none
	{
		clampmap gore/bloodpool1_green.tga
		blendFunc GL_ZERO GL_ONE_MINUS_SRC_COLOR
		rgbGen vertex
	}
}

