		visible 1
		action { close xbox_achreset3 ; open ingame_cheats }
	}

	itemDef {
		name yes
		type ITEM_TYPE_BUTTON
		text "Reset"
		rect 30 95 240 18
		textfont UI_FONT_DEFAULT
		textscale .24
		textalign ITEM_ALIGN_LEFT
		textalignx 10
		textaligny 14
		style WINDOW_STYLE_FILLED
		backcolor 1 1 1 .07
		forecolor 1 .55 .45 1
		visible 1
		action { exec "xbachreset" ; close xbox_achreset3 ; open ingame_cheats }
	}

}

