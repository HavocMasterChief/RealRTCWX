		visible 1
		decoration
	}

	itemDef
	{
		name realrtcw_ingame_quit
		style WINDOW_STYLE_SHADER
		rect -107 0 480 480
		background "ui/assets/realrtcw_ingame_quit.tga"
		visible 1
		decoration
	}

	itemDef
	{
	name save
	
	cvarTest "g_gameType"
	hideCvar { "3" }
	
	type 1
	rect 10 144 178 26
	visible 1
	action { open ingame_save }
	mouseEnter { show "realrtcw_ingame_save" } 
	mouseExit { hide "realrtcw_ingame_save" } 
	}

	itemDef
	{
	name load
	
	cvarTest "g_gameType"
	hideCvar { "3" }
	
	type 1
	rect 10 177 178 26 
