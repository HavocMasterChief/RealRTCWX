	text "ACHIEVEMENTS"
	rect 10 404 178 26
	textfont UI_FONT_DEFAULT
	textscale .3
	textalign ITEM_ALIGN_LEFT
	textalignx 14
	textaligny 20
	forecolor .85 .78 .64 1
	visible 1
	action { open ingame_achievements }
	}

}


