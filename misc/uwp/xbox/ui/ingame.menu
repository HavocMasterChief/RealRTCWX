	}
	
	itemDef
	{
	name leave
	type 1
	rect 10 309 178 26
	visible 1
	action { uiscript leave }
	mouseEnter { show "realrtcw_ingame_main" } 
	mouseExit { hide "realrtcw_ingame_main" } 
	}
	
	itemDef
	{
	name quit
	type 1
	rect 10 342 178 26
	visible 1
	action { uiscript quit }
	mouseEnter { show "realrtcw_ingame_quit" }
	mouseExit { hide "realrtcw_ingame_quit" }
	}

	itemDef
	{
	name xbcheats
	type 1
	text "CHEATS"
	cvarTest "g_gameType"
	hideCvar { "3" }
	rect 10 375 178 26
	textfont UI_FONT_DEFAULT
	textscale .3
	textalign ITEM_ALIGN_LEFT
	textalignx 14
	textaligny 20
	forecolor .85 .78 .64 1
	visible 1
