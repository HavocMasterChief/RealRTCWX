    itemDef {
	    name lookbutton
	    text "Layout"
	    type 1
	    textscale .23
	    group controlbuttons
	    type ITEM_TYPE_BUTTON
	    style WINDOW_STYLE_FILLED
	    rect 250 105 64 20
	    textalign 1
		textfont UI_FONT_BIG
	    textalignx 32
	    textaligny 14
	    border 1
	    bordercolor .1 .1 .1 0
	    forecolor 1 1 1 1
	    visible 0
	    action { hide controls ; show look }
	    mouseEnter { setitemcolor ctr_look backcolor .3 .6 .3 .0 } 
	    mouseExit { setitemcolor ctr_look backcolor .1 .1 .1 0 } 
	}
    itemDef {
	    name look
	    text "@CONTROLS"
 	    type 1
	    textfont UI_FONT_BIG
	    style 0	
	    textstyle 6
	    rect 222.5 -12 64 14 
	    textalign ITEM_ALIGN_CENTER
	    textscale .23		
	    textalignx 2
	    textaligny 12
	    forecolor .9 .9 .9 1
	    visible 0 
	    decoration
    }
	itemDef {
		name look
		group controls
		style WINDOW_STYLE_SHADER
		background "ui/xbox_controller"
		rect 226 128 431 216
		forecolor 1 1 1 1
		visible 0
		decoration
	}
