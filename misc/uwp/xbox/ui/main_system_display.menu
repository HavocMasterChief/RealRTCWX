	    itemDef {
	    name systembutton
	    text "@SYSTEM_DISPLAY"
	    type ITEM_TYPE_BUTTON
		textfont UI_FONT_BIG
	    textscale .23
	    group systemmenus
	    style WINDOW_STYLE_FILLED
	    rect 250 105 45 20
	    textalign 1
	    textalignx 22
	    textaligny 14
	    forecolor 1 1 1 1
 	    visible 0
	    action { hide system ; hide iortcwgraphics; hide performancegraphics ; show graphics ; show graphicsapply }
	}
	
