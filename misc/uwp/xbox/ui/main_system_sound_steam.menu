/////////////////////////////               SOUND SYSTEM MENU          //////////////////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
	
    itemDef {
	    name soundbutton
	    text "@SOUND"
		textfont UI_FONT_BIG
	    type 1
	    textscale .23
	    group systemmenus
	    style WINDOW_STYLE_FILLED
	    rect 506 105 45 20
	    textalign 1
	    textalignx 22
	    textaligny 14
	    forecolor .9 .9 .9 .8
	    backcolor .1 .1 .1 0
	    visible 0
	    action { hide system ; show sounds ; show applysys }
	    mouseEnter { show message_other ; setitemcolor ctr_other backcolor .3 .3 .3 0 }
	    mouseExit { hide message_other ; setitemcolor ctr_other backcolor .1 .1 .1 0}
	}

